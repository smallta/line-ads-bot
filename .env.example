# ==========================================
# LINE Messaging API 設定
# 請在 https://developers.line.biz/ 申請
# ==========================================
# Channel Secret (位於 Basic settings 頁籤)
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Channel Access Token (long-lived) (位於 Messaging API 頁籤)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 管理員 LINE User ID (用於推播晨報與警報，位於 Basic settings 最底部的 Your user ID)
# 格式為 U 開頭的 33 碼字串，例如：U1234567890abcdef1234567890abcdef
ADMIN_LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook 伺服器監聽連接埠 (預設 3000)
PORT=3000

# ==========================================
# Meta Marketing API 憑證 (與 meta-ads-mcp 共用)
# ==========================================
META_ACCESS_TOKEN=EAAG...
META_AD_ACCOUNT_ID=act_4000297516716904
META_API_VERSION=v20.0

# ==========================================
# Google Gemini AI Agent 設定
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

