# ==========================================
# LINE Messaging API 設定
# 請在 https://developers.line.biz/ 申請
# ==========================================
# Channel Secret (位於 Basic settings 頁籤)
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Channel Access Token (long-lived) (位於 Messaging API 頁籤)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# 管理員 LINE User ID (用於推播晨報與晚報警報，位於 Basic settings 最底部的 Your user ID)
# 格式為 U 開頭的 33 碼字串，若有多個管理員請以半形逗號分隔
ADMIN_LINE_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook 伺服器監聽連接埠 (預設 3000)
PORT=3000

# ==========================================
# Meta Marketing API 憑證
# 請在 Meta for Developers 系統用戶產生長效 Token (需 ads_read 權限)
# ==========================================
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_AD_ACCOUNT_ID=act_1234567890123456
META_API_VERSION=v20.0

# ==========================================
# Google Gemini AI Agent 設定
# 請在 Google AI Studio (https://aistudio.google.com/) 申請
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# 伺服器公開 URL (用於常駐 KeepAlive 自我心跳保活)
# ==========================================
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
